diff --color -Nur p1/0001-support-limine-uefi-architectures.patch p2/0001-support-limine-uefi-architectures.patch
--- a/0001-support-limine-uefi-architectures.patch	1969-12-31 19:00:00.000000000 -0500
+++ b/0001-support-limine-uefi-architectures.patch	2026-08-25 20:59:40.087282852 -0400
@@ -0,0 +1,164 @@
+Support the architectures Limine already ships UEFI binaries for
+
+Zesko/limine-entry-tool merge request !63 (Sean Baker), merged into master on
+2026-08-25 as e5540d97, not yet in a tagged release (latest: 1.37.1).
+https://gitlab.com/Zesko/limine-entry-tool/-/merge_requests/63
+
+Without it `limine-install` exits 0 on aarch64 ("The system is not x86_64.")
+and `limine-entry-tool --add-uki` exits with an error, so an aarch64 install
+builds its UKI and never gets a Limine entry.
+
+RETIRE: delete this file and its prepare() line when the PKGBUILD's pkgver is
+the first tagged release that contains e5540d97.
+
+diff --git a/install/arch-linux/limine-entry-tool/usr/bin/limine-install b/install/arch-linux/limine-entry-tool/usr/bin/limine-install
+index f9491f87746993097d17ee7c98bd8b85dc849761..d2a36d841b76f4e979d37110c5d2a1690126ab80 100755
+--- a/install/arch-linux/limine-entry-tool/usr/bin/limine-install
++++ b/install/arch-linux/limine-entry-tool/usr/bin/limine-install
+@@ -68,8 +68,8 @@ else
+ 	}
+ fi
+ 
+-is_x64 || {
+-	info_msg "The system is not x86_64."
++is_supported_arch || {
++	info_msg "No Limine EFI binary for $(uname -m)."
+ 	exit 0
+ }
+ 
+@@ -372,7 +372,7 @@ check_limine_config_conflicts
+ 
+ # Optionally add some bootloaders if they are present on the same ESP
+ if [[ "${FIND_BOOTLOADERS:-no}" == "yes" && "${SKIP_UEFI:-no}" == "no" ]]; then
+-	bootloader_path="${ESP_PATH}/EFI/systemd/systemd-bootx64.efi"
++	bootloader_path="${ESP_PATH}/EFI/systemd/systemd-boot$(limine_efi_arch | tr "[:upper:]" "[:lower:]").efi"
+ 	if [[ -f "${bootloader_path}" ]]; then
+ 		limine-entry-tool --add-efi "Systemd-boot" "${bootloader_path}" --comment "Systemd bootloader" --priority 20 --quiet --no-mutex --no-hooks
+ 	fi
+@@ -382,7 +382,7 @@ if [[ "${FIND_BOOTLOADERS:-no}" == "yes" && "${SKIP_UEFI:-no}" == "no" ]]; then
+ 		limine-entry-tool --add-efi "rEFInd" "${bootloader_path}" --comment "rEFInd bootloader" --priority 20 --quiet --no-mutex --no-hooks
+ 	fi
+ 
+-	bootloader_path="${ESP_PATH}/EFI/BOOT/BOOTX64.EFI"
++	bootloader_path="${ESP_PATH}/EFI/BOOT/BOOT$(limine_efi_arch).EFI"
+ 	if [[ -f "${bootloader_path}" ]]; then
+ 		limine-entry-tool --add-efi "EFI fallback" "${bootloader_path}" --comment "Default EFI loader" --priority 10 --quiet --no-mutex --no-hooks
+ 	fi
+diff --git a/install/arch-linux/limine-entry-tool/usr/lib/limine/limine-common-functions b/install/arch-linux/limine-entry-tool/usr/lib/limine/limine-common-functions
+index b56cc3019273ce9de66af8b74893797254e5fb38..1db04b9063a3b0ce8a41396c93187bcf386b7c87 100644
+--- a/install/arch-linux/limine-entry-tool/usr/lib/limine/limine-common-functions
++++ b/install/arch-linux/limine-entry-tool/usr/lib/limine/limine-common-functions
+@@ -56,6 +56,23 @@ is_x64() {
+ 	[[ "$(uname -m)" == "x86_64" ]]
+ }
+ 
++# Limine ships BOOTX64/BOOTIA32/BOOTAA64/BOOTRISCV64/BOOTLOONGARCH64; this tool
++# only ever used the x64 one. Map the machine to the binary it actually has.
++limine_efi_arch() {
++	case "$(uname -m)" in
++		x86_64)      echo "X64"        ;;
++		i?86)        echo "IA32"       ;;
++		aarch64)     echo "AA64"       ;;
++		riscv64)     echo "RISCV64"    ;;
++		loongarch64) echo "LOONGARCH64";;
++		*)           return 1          ;;
++	esac
++}
++
++is_supported_arch() {
++	limine_efi_arch >/dev/null 2>&1
++}
++
+ ### Load key=value config
+ load_key_value_config() {
+ 	local file="$1"
+@@ -327,7 +344,7 @@ restore_limine_binary() {
+ }
+ 
+ reset_enroll_config() {
+-	is_x64 || return 0
++	is_supported_arch || return 0
+ 	is_uefi || return 0
+ 	if restore_limine_binary; then
+ 		return 0
+@@ -342,7 +359,7 @@ reset_enroll_config() {
+ 
+ ### Enroll Limine config into Limine binary file, then sign the binary.
+ enroll_config() {
+-	is_x64 || return 0
++	is_supported_arch || return 0
+ 	is_uefi || return 0
+ 	restore_limine_binary
+ 	if [[ -f "$LIMINE_CONFIG_PATH" && "$ENABLE_ENROLL_LIMINE_CONFIG" == "yes" ]]; then
+@@ -385,16 +402,17 @@ initialize_header() {
+ 	if [[ -n "${LIMINE_BINARY_PATH:-}" ]]; then
+ 		export BINARY_SOURCE_PATH="$LIMINE_BINARY_PATH"
+ 	else
+-		export BINARY_SOURCE_PATH="/usr/share/limine/BOOTX64.EFI"
++		export BINARY_SOURCE_PATH="/usr/share/limine/BOOT$(limine_efi_arch).EFI"
+ 	fi
+ 
+ 	export LIMINE_DIR_PATH="${ESP_PATH}/EFI/limine/"
+-	export LIMINE_EFI_FILE="limine_x64.efi"
+-	export LIMINE_BACKUP_FILE="limine_x64.bak"
++	_limine_arch_lc="$(limine_efi_arch | tr '[:upper:]' '[:lower:]')"
++	export LIMINE_EFI_FILE="limine_${_limine_arch_lc}.efi"
++	export LIMINE_BACKUP_FILE="limine_${_limine_arch_lc}.bak"
+ 
+ 	export BINARY_TARGET_PATH="${LIMINE_DIR_PATH}${LIMINE_EFI_FILE}"
+ 	export BINARY_BACKUP_PATH="${LIMINE_DIR_PATH}${LIMINE_BACKUP_FILE}"
+-	export BINARY_FALLBACK_PATH="${ESP_PATH}/EFI/BOOT/BOOTX64.EFI"
++	export BINARY_FALLBACK_PATH="${ESP_PATH}/EFI/BOOT/BOOT$(limine_efi_arch).EFI"
+ 
+ 	export LIMINE_EFI_PATH="\\EFI\\limine\\${LIMINE_EFI_FILE}"
+ 	export LIMINE_CONFIG_PATH="${ESP_PATH}/limine.conf"
+diff --git a/src/main/java/org/limine/entry/tool/Main.java b/src/main/java/org/limine/entry/tool/Main.java
+index 3898db2b36314c01b13e8e37d12900cdf56decab..e69949261e74eff25329ce771a9d4673deb95ede 100644
+--- a/src/main/java/org/limine/entry/tool/Main.java
++++ b/src/main/java/org/limine/entry/tool/Main.java
+@@ -280,8 +280,8 @@ public class Main {
+     }
+ 
+     private static void addUki(String kernelName, String comment, EntryOptions kernelEntryOptions, String ukiFilePath) throws IOException {
+-        if (!Utility.isSystemAmd64()) {
+-            exitWithError("Your system is not using x86_64 architecture");
++        if (!Utility.isSystemSupportedArch()) {
++            exitWithError("Limine has no UEFI binary for this architecture");
+         }
+         if (!Utility.isSystemEfi()) {
+             exitWithError("Your system is not using EFI mode");
+@@ -311,8 +311,8 @@ public class Main {
+     }
+ 
+     private static void addEfi(String efiName, String comment, EntryOptions kernelEntryOptions, String efiFilePath, boolean shouldCheckDevice) throws IOException {
+-        if (shouldCheckDevice && !Utility.isSystemAmd64()) {
+-            exitWithError("Your system is not using x86_64 architecture");
++        if (shouldCheckDevice && !Utility.isSystemSupportedArch()) {
++            exitWithError("Limine has no UEFI binary for this architecture");
+             return;
+         }
+         if (shouldCheckDevice && !Utility.isSystemEfi()) {
+diff --git a/src/main/java/org/limine/entry/tool/processes/Utility.java b/src/main/java/org/limine/entry/tool/processes/Utility.java
+index 728e2c76cadbb2d055fc2ba34e21dfc793e8b38f..6e0d715bbf7dbbec4adc4e02204bc418a090b4ee 100644
+--- a/src/main/java/org/limine/entry/tool/processes/Utility.java
++++ b/src/main/java/org/limine/entry/tool/processes/Utility.java
+@@ -570,6 +570,19 @@ public class Utility {
+     }
+ 
+ 
++    /**
++     * Check if Limine ships a UEFI binary for this architecture.
++     * Limine provides BOOTX64/BOOTIA32/BOOTAA64/BOOTRISCV64/BOOTLOONGARCH64,
++     * so gating entry management on x86_64 alone is unnecessarily narrow.
++     */
++    public static boolean isSystemSupportedArch() {
++        String arch = System.getProperty("os.arch").toLowerCase();
++        return arch.equals("x86_64") || arch.equals("amd64")
++                || arch.equals("aarch64") || arch.equals("arm64")
++                || arch.equals("riscv64") || arch.equals("loongarch64");
++    }
++
++
+     /**
+      * Validates if the given path is a valid boot partition using FAT32.
+      *
diff --color -Nur p1/PKGBUILD p2/PKGBUILD
--- a/PKGBUILD	2026-08-25 20:59:40.083752749 -0400
+++ b/PKGBUILD	2026-08-25 20:59:40.101506829 -0400
@@ -8,7 +8,11 @@
 pkgdesc="Install kernels for the Limine bootloader."
 arch=('x86_64' 'aarch64')
 url="https://gitlab.com/Zesko/limine-entry-tool"
-source=("${_pkgname}::git+${url}.git#tag=${pkgver}")
+# 0001: Zesko !63 (merged 2026-08-25, not in a tagged release yet) -- without
+# it limine-install and limine-entry-tool --add-uki refuse every architecture
+# but x86_64. Retire when pkgver is the first tag that contains it.
+source=("${_pkgname}::git+${url}.git#tag=${pkgver}"
+        "0001-support-limine-uefi-architectures.patch")
 source_x86_64=("https://github.com/graalvm/graalvm-ce-builds/releases/download/graal-25.1.3/graalvm-community-jdk-25i1-25.0.3_linux-x64_bin.tar.gz")
 # Arch Linux ARM ships no gradle package, so aarch64 builds from Gradle's own
 # binary distribution (the same version Arch packages). Retire the extra
@@ -36,7 +40,8 @@
 makedepends_x86_64=('gradle')
 backup=(etc/limine-entry-tool.conf)
 conflicts=('limine-entry-tool')
-sha256sums=('e0a1d5800ef1b0a79eee935d1a295d4b929a713686e8bb8340484d402deb5621')
+sha256sums=('e0a1d5800ef1b0a79eee935d1a295d4b929a713686e8bb8340484d402deb5621'
+            'SKIP')
 sha256sums_x86_64=('e9cd1637be853e105f8b09125b4b19fbce385696465d782cbca8bb80e1df8f0d')
 sha256sums_aarch64=('5e79978983439d28506ebef82254fe9f98995121208dc8be77c604f4ad5bc579'
                     '84fbba45c7f4c64abc77460e1c00f541e9f960e3c7ed2538f1ede19eacd873ae')
@@ -48,6 +53,12 @@
 		echo "Error: ${_graalvm_version}/bin/javac not found." >&2
 		return 1
 	fi
+	# The carried patches only matter on aarch64; x86_64 builds stay identical
+	# to upstream.
+	if [[ "$CARCH" == aarch64 ]]; then
+		cd "$srcdir/${_pkgname}"
+		patch -p1 -i "$srcdir/0001-support-limine-uefi-architectures.patch"
+	fi
 }
 
 build() {
